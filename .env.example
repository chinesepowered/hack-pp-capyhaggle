# Capy vs Capy: environment variables. Names only; put real values in .env.local (git-ignored).
# Everything is server-side except NEXT_PUBLIC_*.

# --- PayPal (sandbox only) ---------------------------------------------------
# Always "sandbox". The app refuses to start PayPal calls with any other value.
PAYPAL_ENVIRONMENT=sandbox
# From developer.paypal.com > Apps & Credentials > Sandbox > your REST app (Payouts must be enabled on the app).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Same value as PAYPAL_CLIENT_ID. Used in the browser by PayPal JS SDK v6.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# A sandbox PERSONAL account (Sandbox > Accounts). It plays Maya, the buyer. Used by `pnpm seed`
# and the recording scripts to approve orders in PayPal's own window. Not needed by the deployed app.
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=
# A second sandbox PERSONAL account. It plays Theo, the seller, and receives the payouts.
PAYPAL_SANDBOX_SELLER_EMAIL=
# Printed by `pnpm paypal:webhook <public-url>` after deploying. Without it the webhook route
# rejects every delivery (nothing can be verified); the app still works because it polls PayPal.
PAYPAL_WEBHOOK_ID=

# --- AI (W&B Inference, OpenAI-compatible) -----------------------------------
OPENAI_BASE_URL=https://api.inference.wandb.ai/v1
# From wandb.ai > Inference > API key.
OPENAI_API_KEY=
# Chat model with tool calling: the two negotiating agents, price estimate, scam check, summaries.
OPENAI_MODEL=Qwen/Qwen3.8-27B
# Vision model: writes the listing from photos.
OPENAI_VISION_MODEL=google/gemma-4-31B-it
# Used when the chat model fails repeatedly or returns nothing.
OPENAI_FALLBACK_MODEL=zai-org/GLM-5.3-Flash

# --- Secrets you generate yourself (for example: openssl rand -hex 32) --------
# Signs the agents' mandates (HMAC-SHA256).
MANDATE_SIGNING_SECRET=
# Signs the single-use pickup QR codes.
QR_SIGNING_SECRET=
# Required in the x-admin-token header of POST /api/admin/reset.
DEMO_ADMIN_TOKEN=

# --- Hosting -------------------------------------------------------------------
# Public origin of the app, used for PayPal return and cancel URLs. On Vercel it is derived
# automatically; set it when running somewhere else. Default: http://localhost:3000
APP_URL=
# Set by Vercel when a Blob store is connected. With it, app state lives in Vercel Blob;
# without it, in files under .data/ (or /tmp on Vercel, which does not persist).
BLOB_READ_WRITE_TOKEN=
# "private" (default) or "public", matching how the Blob store was created.
BLOB_ACCESS=private

# --- Build-time only (never used by the running app) ---------------------------
# Used by scripts/voice-lines.ts and scripts/video/narrate.ts to render audio files.
ELEVENLABS_API_KEY=
